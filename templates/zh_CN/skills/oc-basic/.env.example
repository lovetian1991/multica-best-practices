# OpenContent AI Skill 环境配置
# 复制此文件为 .env 并填写实际值

# Multica 服务地址（无尾斜杠；请求通过 /api/opencontent/{operation} 转发）
MULTICA_SERVER_URL=http://localhost:8080

# OpenContent API Key（仅在 skill 运行环境中配置）
OPENCONTENT_APIKEY=your-api-key

# 可选：HTTP 代理（适用于需要通过代理访问 OpenContent 服务器的网络环境）
# HTTP_PROXY=http://127.0.0.1:7890
