# The bundled cli/bin/oc.js is used by default.
# Set this only when overriding it with an external oc-basic executable or oc.js.
# OC_CLI_PATH=/path/to/oc.js
# OPENCONTENT_CLI_PATH is accepted as an alternative variable name.
# OPENCONTENT_CLI_PATH=/path/to/oc.js

# oc-basic itself reads these at runtime. Keep them outside Git.
# MULTICA_SERVER_URL=<MULTICA_SERVER_URL>
# OPENCONTENT_APIKEY=<OPENCONTENT_API_KEY>
# MULTICA_KB_FOLDER_ID=<current issue root folder id>

# Browser-facing address of the KB platform, used to rewrite the origin of the
# preview link oc.js builds from MULTICA_SERVER_URL. Set it to the same value as
# the KB 环境地址 in Multica system settings.
# OPENCONTENT_WEB_URL=https://kb.example.com
