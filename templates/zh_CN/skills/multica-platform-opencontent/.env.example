# Path to the oc-basic executable, wrapper, or node dist/bin/oc.js.
OC_CLI_PATH=oc
# OPENCONTENT_CLI_PATH is accepted as an alternative variable name.
# OPENCONTENT_CLI_PATH=/path/to/opencontent-base/node/dist/bin/oc.js

# oc-basic itself reads these at runtime. Keep them outside Git.
# MULTICA_SERVER_URL=<MULTICA_SERVER_URL>
# OPENCONTENT_APIKEY=<OPENCONTENT_API_KEY>
